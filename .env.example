# Copy to .env for local development. In a deployment these come from the secret store.

# ----- Django -----
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Local development only. Off (the default) turns on secure cookies, HTTPS redirect and HSTS.
DJANGO_DEBUG=true
# Comma-separated host names the site answers on (empty + DEBUG = localhost only).
DJANGO_ALLOWED_HOSTS=
# Behind an ingress that terminates TLS and sets X-Forwarded-Proto itself.
# DJANGO_BEHIND_TLS_PROXY=true
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DEV / TEST / PROD, as in the services; PROD writes JSON log lines.
# ENVIRONMENT=DEV
# LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ----- Django's own database (employees, sessions, access log) -----
# SQLite in the project folder by default. For PostgreSQL also add psycopg to requirements.txt.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=

# ----- Email (sign-in links). Without EMAIL_HOST emails print in the runserver terminal. -----
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=

# ----- Product RabbitMQ: service data is read through each service's admin RPC queries -----
# Locally the broker is on host port 5673; use the same user/password as the services' .env.
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
# Must equal the services' RABBITMQ_SUFFIX (pro3ai_generic appends it to routing keys).
RABBITMQ_SUFFIX=
# Optional: seconds to wait for a service reply (default 8)
# ADMIN_RPC_TIMEOUT=8
