# Product RabbitMQ: service data is read through each service's admin RPC queries.
# Locally the broker is on host port 5673; use the same user/password as the services' .env.
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
# Must equal the services' RABBITMQ_SUFFIX (pro3ai_generic appends it to routing keys).
RABBITMQ_SUFFIX=
# Optional: seconds to wait for a service reply (default 8)
# ADMIN_RPC_TIMEOUT=8
